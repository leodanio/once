# ============================================================================
# ONCE — Environment Variables
# Copy this file to .env.local and fill in your Supabase project credentials.
# Never commit .env.local or actual secrets to version control.
# ============================================================================

# Public Supabase project URL (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase anonymous / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only Supabase Service Role / Secret key
# CRITICAL: Never expose this key to the browser or prefix it with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Public base URL used to construct generated short links
NEXT_PUBLIC_APP_URL=http://localhost:3000
